{
  "name": "arregla-ya-backend",
  "version": "0.1.0",
  "private": true,
  "description": "API académica NestJS + PostgreSQL + TypeORM",
  "scripts": {
    "start": "node dist/main.js",
    "start:dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "seed:admin": "ts-node src/seed-admin.ts"
  },
  "dependencies": {
    "@nestjs/common": "^12.3.0",
    "@nestjs/core": "^12.3.0",
    "@nestjs/platform-express": "^12.3.0",
    "@nestjs/typeorm": "^12.0.2",
    "@nestjs/jwt": "^12.0.1",
    "typeorm": "^0.3.27",
    "pg": "^8.13.0",
    "bcryptjs": "^3.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "^16.6.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/bcryptjs": "^2.4.6",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "~6.0.2"
  }
}
