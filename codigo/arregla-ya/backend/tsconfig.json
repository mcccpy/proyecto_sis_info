
{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2022",
    "lib": [
      "es2022"
    ],
    "declaration": false,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "skipLibCheck": true,
    "moduleResolution": "node",
    "ignoreDeprecations": "6.0",
    "useDefineForClassFields": false
  },
  "exclude": [
    "node_modules",
    "dist"
  ]
}
